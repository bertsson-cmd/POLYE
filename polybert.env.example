# PolyBert live-trading environment file.
#
# Copy this to polybert.env, fill in real values, then:
#   chmod 600 polybert.env
# NEVER commit the filled-in file -- it holds a wallet private key. Never
# put the private key anywhere but this file on the VPS: not in the repo,
# not in a commit, not in a chat message, not in a log line.

# ---------------------------------------------------------------- gates
# Selecting the live engine at all. This alone does NOT place real orders --
# an ARMED file must also exist in the working directory, and DRY_RUN below
# must be explicitly set to 0. See LIVE.md for the full sequence.
POLYEDGE_LIVE=1
# Leave at 1 (dry-run) for the first 24-48h+ of real deployment. Only flip
# to 0 after LIVE.md's dry-run checklist and with the owner's explicit go-ahead.
POLYEDGE_DRY_RUN=1

# ---------------------------------------------------------------- wallet / polymarket-client
# Trades against Polymarket's CLOB V2 via polymarket-client (imports as
# `polymarket`, GitHub Polymarket/py-sdk) -- V2 collateral is pUSD, not
# USDC.e. Before this bot can place its first live order, fund
# POLYEDGE_FUNDER_ADDRESS with USDC.e on Polygon and WRAP it into pUSD via
# the Collateral Onramp's wrap() function yourself -- unlike Polymarket's
# own UI, the API does not do this for you, and this bot does not call
# wrap() automatically either (that's a deliberate, infrequent, one-time
# operator action, not something to automate blind). live.py checks
# tradeable pUSD balance before every live order and halts loudly if it's
# missing -- see LIVE.md's go-live checklist.
#
# This account's wallet is a deposit wallet (signature_type=3/POLY_1271)
# -- its exchange hard-rejects the older POLY_PROXY (signature_type=1)
# order path outright ("maker address not allowed, please use the deposit
# wallet flow"). POLYEDGE_FUNDER_ADDRESS below IS the deposit wallet
# address (confirmed the same address for this account) -- polymarket-client
# derives it automatically from POLYEDGE_PRIVATE_KEY, so there is no
# separate signature_type or chain_id to configure (AsyncSecureClient.create()
# has no such parameters -- confirmed from source). POLYEDGE_FUNDER_ADDRESS
# is still used, but only for the on-chain pUSD balance check and for
# reconcile.py's wallet reconciliation below.
POLYEDGE_PRIVATE_KEY=0xREPLACE_ME
POLYEDGE_FUNDER_ADDRESS=0xREPLACE_ME
# Deposit wallets are gasless (relayed) accounts -- polymarket-client's
# client needs a Builder API Key for that relayed-transaction path, on
# every real order live.py places. Also read by the standalone,
# manually-run scripts/test_deposit_wallet.py diagnostic (same three
# vars, same purpose). Generate one at polymarket.com/settings?tab=builder
# (it gives you all three values together: the key, secret, and
# passphrase, all at once).
POLYEDGE_BUILDER_API_KEY=REPLACE_ME
POLYEDGE_BUILDER_SECRET=REPLACE_ME
POLYEDGE_BUILDER_PASSPHRASE=REPLACE_ME

# ---------------------------------------------------------------- wallet reconciliation
# Automatically compares the bot's own bookkeeping against Polymarket's
# real on-chain record for POLYEDGE_FUNDER_ADDRESS above, every cycle.
# A divergence beyond the threshold halts live trading (same mechanism
# as the daily-loss circuit breaker) -- state that no longer matches the
# real wallet should stop and wait for a human. Only runs at all once
# POLYEDGE_FUNDER_ADDRESS above is set to a real address.
POLYEDGE_RECONCILE_ENABLED=1
POLYEDGE_RECONCILE_HALT_THRESHOLD_PCT=15.0
POLYEDGE_RECONCILE_EVERY_N_CYCLES=1

# ---------------------------------------------------------------- $100 bankroll live profile
# (see the comment at the bottom of polyedge/config.py for the rationale)
POLYEDGE_BANKROLL=100
POLYEDGE_MAX_POS_PCT=0.10
POLYEDGE_MIN_TICKET=5
POLYEDGE_MAX_EXPO_PCT=0.50
POLYEDGE_LS_MAX_OPEN=1

# ---------------------------------------------------------------- circuit breakers
POLYEDGE_LIVE_MAX_DAILY_LOSS=15
# Auto-applied to every live position the moment it opens (via the
# control panel's stop-loss mechanism) -- liquidates automatically if a
# position's marked value drops this % below its cost basis. Set to 0
# to disable entirely (positions would then only stop out via a
# manually-set per-position override in the control panel).
POLYEDGE_DEFAULT_STOP_LOSS_PCT=30.0
# Multi-leg ARB/REL locks stay OFF live by default -- only flip this if you
# specifically understand and accept the legging risk.
POLYEDGE_LIVE_MULTILEG=0

# ---------------------------------------------------------------- loop cadence
POLYEDGE_INTERVAL_SEC=300

# ---------------------------------------------------------------- control panel
# Long random shared secret -- e.g. `openssl rand -hex 32`. Required by
# control_server.py for every POST route (paused/killswitch/liquidate/
# allocation/stop-loss). Bind the control server to 127.0.0.1 and reach it
# over an SSH tunnel or Tailscale rather than exposing it on the open
# internet -- see LIVE.md and MANUAL.md's control-panel section.
POLYBERT_CONTROL_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
